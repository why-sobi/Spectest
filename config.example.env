# Example of SpecTest's shared settings file. Copy it with `spectest config` (it creates the real file in your
# OS config folder: %APPDATA%\spectest\.env or ~/.config/spectest/.env). Never commit real keys.

# LLM providers (tried in this order; any missing key is skipped)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b

# Email reports. Gmail / Google Workspace: host smtp.gmail.com, port 587, and an App Password
# (https://myaccount.google.com/apppasswords), not your normal password.
# If unset, reports are written to .spectest/outbox/ instead. Test with: spectest config --test-email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
